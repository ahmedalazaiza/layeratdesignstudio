# ==========================================
# Layerat Design Studio - Git Ignore Rules
# ==========================================

# Dependencies
node_modules/
.pnpm-store/
.pnp
.pnp.js

# Environment variables & secrets (CRITICAL FOR SECURITY)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env
*.env.*
!.env.example

# Production & Build outputs
dist/
dist-ssr/
build/
out/
.vercel

# Logs & Debugging
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
*.log

# Editor & System Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Temporary & cache
.eslintcache
.stylelintcache
*.tsbuildinfo
.vite/
.cache/